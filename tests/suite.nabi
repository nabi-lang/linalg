// Tests: exact small cases, reconstruction residuals and orthogonality
// against n * eps * ||A|| on seeded random matrices, ill-conditioned
// cases (Hilbert, Vandermonde) with documented tolerances, edge cases
// and the operators.

mod basic;
mod cholesky;
mod eig;
mod eigh;
mod expm;
mod input;
mod lu;
#[cfg(feature = "ops")]
mod ops;
mod qr;
mod solve;
mod svd;

use core::array::Array;
use core::num::Complex;
use std::random::{Rng, Xoshiro256PlusPlus};

pub const EPS: f64 = 2.220446049250313e-16;
pub const EPS32: f64 = 1.1920928955078125e-7;

pub fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

/// `|a - b| <= tol`.
pub fn close(a: f64, b: f64, tol: f64, what: str) {
    if !((a - b).abs() <= tol) { panic(f"check failed: {what}: {a} vs {b} (tol {tol})"); }
}

/// An m x n matrix of uniform values in [-1, 1).
pub fn rand(m: usize, n: usize, seed: u64) -> Array<f64, 2> {
    let g = Xoshiro256PlusPlus::seed(seed);
    let xs: List<f64> = List::with_capacity(m * n);
    for _ in 0..m * n { xs.push(g.uniform(-1.0, 1.0)); }
    Array::from_list(xs, [m, n])
}

pub fn crand(m: usize, n: usize, seed: u64) -> Array<Complex<f64>, 2> {
    let g = Xoshiro256PlusPlus::seed(seed);
    let xs: List<Complex<f64>> = List::with_capacity(m * n);
    for _ in 0..m * n { xs.push(Complex::new(g.uniform(-1.0, 1.0), g.uniform(-1.0, 1.0))); }
    Array::from_list(xs, [m, n])
}

/// A random symmetric positive definite matrix, B B^T + n I.
pub fn spd(n: usize, seed: u64) -> Array<f64, 2> {
    let b = rand(n, n, seed);
    let p = try! pkg::matmul(b, b.t());
    p .+ pkg::eye::<f64>(n) .* (n as f64)
}

/// The n x n Hilbert matrix 1 / (i + j + 1).
pub fn hilbert(n: usize) -> Array<f64, 2> {
    Array::from_fn([n, n], |ix: [usize; 2]| -> f64 { 1.0 / ((ix[0] + ix[1] + 1) as f64) })
}

/// Frobenius norm.
pub fn fro(a: Array<f64, 2>) -> f64 { try! pkg::matrix_norm(a, pkg::Norm::Fro) }

pub fn cfro(a: Array<Complex<f64>, 2>) -> f64 { try! pkg::matrix_norm(a, pkg::Norm::Fro) }

/// ||a - b||_F / (max(||a||_F, tiny) * n * eps): the residual in units
/// of the backward-stable bound.
pub fn units(a: Array<f64, 2>, b: Array<f64, 2>, n: usize) -> f64 {
    let s = fro(a);
    fro(a .- b) / ((if s > 0.0 { s } else { 1.0 }) * (n.max(1) as f64) * EPS)
}

/// ||Q^T Q - I||_F / (n eps).
pub fn orth(q: Array<f64, 2>) -> f64 {
    let k = q.shape()[1];
    let g = try! pkg::matmul(q.t(), q);
    fro(g .- pkg::eye::<f64>(k)) / ((q.shape()[0].max(1) as f64) * EPS)
}

/// Every element of the residual within `tol`.
pub fn all_close(a: Array<f64, 2>, b: Array<f64, 2>, tol: f64, what: str) {
    expect(a.shape() == b.shape(), f"{what}: shapes {a.shape():?} vs {b.shape():?}");
    for (x, y) in a.iter().zip(b.iter()) { close(x, y, tol, what); }
}

/// Whether `f` throws `e`.
pub fn throws_kind(f: fn() throws (pkg::LinalgError), want: str) -> bool {
    try { f(); false } catch e: pkg::LinalgError {
        let k = match e {
            pkg::LinalgError::Singular { .. } => "Singular",
            pkg::LinalgError::NotSquare { .. } => "NotSquare",
            pkg::LinalgError::ShapeMismatch { .. } => "ShapeMismatch",
            pkg::LinalgError::NotPositiveDefinite { .. } => "NotPositiveDefinite",
            pkg::LinalgError::NoConvergence { .. } => "NoConvergence",
            pkg::LinalgError::NotFinite => "NotFinite",
        };
        k == want
    }
}
