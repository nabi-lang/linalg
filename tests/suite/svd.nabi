use pkg::tests::suite::{EPS, EPS32, close, expect, fro, hilbert, orth, rand, throws_kind, units};
use core::array::{Array, Matrix, Vector};
use core::num::Complex;

fn rebuild(f: pkg::Svd<f64>) -> Matrix<f64> {
    let us = f.u() .* f.s()[none, :];
    try! pkg::matmul(us, f.vt())
}

#[test]
fn exact() {
    let a: Matrix<f64> = [[0, 2], [1, 0], [0, 0]];
    let f = try! pkg::svd(a);
    expect(f.s() == Vector::<f64>::from([2.0, 1.0]), f"s {f.s():?}");
    // [[2, 0], [1, 1]]: s = sqrt(3 +- sqrt(5)).
    let b: Matrix<f64> = [[2, 0], [1, 1]];
    let s = (try! pkg::svd(b)).s();
    close(s[0], (3.0 + 5.0.sqrt()).sqrt(), 1e-15, "s0");
    close(s[1], (3.0 - 5.0.sqrt()).sqrt(), 1e-15, "s1");
}

#[test]
fn reconstruction() {
    for (m, n) in [(1usize, 1usize), (1, 6), (6, 1), (8, 8), (50, 20), (20, 50), (64, 64)] {
        let a = rand(m, n, (3 * m + n) as u64);
        let f = try! pkg::svd(a);
        let k = m.min(n);
        expect(f.u().shape() == [m, k] && f.vt().shape() == [k, n], "thin shapes");
        let r = units(a, rebuild(f), m.max(n));
        expect(r < 8.0, f"||A - USV^T|| = {r} at {m} x {n}");
        expect(orth(f.u()) < 8.0 && orth(f.v()) < 8.0, f"orthogonality at {m} x {n}");
        let s = f.s();
        for i in 1..k { expect(s[i] <= s[i - 1], "falling"); }
        let g = try! pkg::svd_full(a);
        expect(g.u().shape() == [m, m] && g.vt().shape() == [n, n], "full shapes");
        expect(orth(g.u()) < 8.0 && orth(g.v()) < 8.0, "full orthogonality");
        let sv = try! pkg::svdvals(a);
        for i in 0..k { close(sv[i], s[i], 1e-13, "svdvals"); }
    }
}

#[test]
fn rank_deficient() {
    // Rank 2: the third column is the sum of the others.
    let a: Matrix<f64> = [[1, 2, 3], [4, 5, 9], [7, 8, 15], [1, 0, 1]];
    let f = try! pkg::svd_full(a);
    expect(f.rank(none) == 2, "rank");
    expect(try! pkg::rank(a) == 2, "rank()");
    expect(units(a, rebuild(try! pkg::svd(a)), 4) < 8.0, "rank-deficient reconstruction");
    expect(orth(f.u()) < 8.0, "U completed");
    let z = try! pkg::null_space(a);
    expect(z.shape() == [3, 1], "null space dim");
    let az = try! pkg::matmul(a, z);
    expect(fro(az) < 1e-13, "A z = 0");
    let zero: Matrix<f64> = Array::zeros([3, 4]);
    let g = try! pkg::svd(zero);
    expect(g.s() == Vector::<f64>::zeros([3]) && orth(g.u()) < 1.0, "zero matrix");
    expect(try! pkg::cond(zero) == f64::INFINITY, "cond of zero");
}

#[test]
fn ill_conditioned() {
    // Hilbert 10 (cond 1.6e13): s_min is 1 / s_max of the exact
    // integer inverse, which eigh gets to a few eps relative. A
    // QR-iteration SVD promises eps * s_max absolute, 3.5e-3 relative
    // here; the pivoted QR + Jacobi path measured 7.7e-5. The documented
    // tolerance is 1e-3 relative.
    let n = 10usize;
    let h = hilbert(n);
    let s = (try! pkg::svd(h)).s();
    close(s[0], 1.7519196702651774, 1e-14, "s_max(H10)");
    let w = (try! pkg::eigh(hilbert_inv(n))).values();
    let smin = 1.0 / w[n - 1];
    close(s[n - 1] / smin, 1.0, 1e-3, "s_min(H10)");
    // Vandermonde of 1..8: entries up to 8^7, still reconstructed to
    // n eps ||A||.
    let v: Matrix<f64> = Array::from_fn([8, 8], |ix: [usize; 2]| -> f64 { ((ix[0] + 1) as f64) ** (ix[1] as i32) });
    expect(units(v, rebuild(try! pkg::svd(v)), 8) < 8.0, "Vandermonde");
}

#[test]
fn pinv_identities() {
    let a = rand(7, 4, 11);
    let p = try! pkg::pinv(a);
    expect(p.shape() == [4, 7], "shape");
    let apa = try! pkg::matmul(try! pkg::matmul(a, p), a);
    expect(units(a, apa, 7) < 20.0, "A A+ A = A");
    let pap = try! pkg::matmul(try! pkg::matmul(p, a), p);
    expect(units(p, pap, 7) < 20.0, "A+ A A+ = A+");
    let pt = try! pkg::pinv(a.t().copy());
    expect(fro(pt .- p.t()) < 1e-13, "pinv(A^T) = pinv(A)^T");
}

#[test]
fn types_and_edges() {
    let a = rand(12, 7, 21).map(|x: f64| -> f32 { x as f32 });
    let f = try! pkg::svd(a);
    let us = f.u() .* f.s()[none, :];
    let back = try! pkg::matmul(us, f.vt());
    let m = 0.0f32;
    for x in back .- a { m = m.max(x.abs()); }
    expect((m as f64) < 12.0 * 12.0 * EPS32, f"f32 residual {m}");
    // A unitary complex matrix: every singular value is 1.
    let r = 0.5.sqrt();
    let u: Matrix<Complex<f64>> = [[r + 0.0i, r * 1.0i], [r * 1.0i, r + 0.0i]];
    let s = try! pkg::svdvals(u);
    close(s[0], 1.0, 1e-15, "unitary s0");
    close(s[1], 1.0, 1e-15, "unitary s1");
    let nan: Matrix<f64> = [[1, f64::NAN]];
    expect(throws_kind(|| { _ = try pkg::svd(nan); }, "NotFinite"), "nan");
    let e: Matrix<f64> = Array::zeros([0, 3]);
    let g = try! pkg::svd_full(e);
    expect(g.s().len() == 0 && g.vt().shape() == [3, 3], "0 x 3");
    expect(try! pkg::rank(e) == 0, "rank of empty");
    let _ = EPS;
}

fn choose(n: usize, k: usize) -> f64 {
    let r = 1.0;
    for i in 0..k { r = r * ((n - i) as f64) / ((i + 1) as f64); }
    r.round()
}

/// The exact inverse of the n x n Hilbert matrix (integers).
fn hilbert_inv(n: usize) -> Matrix<f64> {
    Array::from_fn([n, n], |ix: [usize; 2]| -> f64 {
        let (i, j) = (ix[0] + 1, ix[1] + 1);
        let sign = if (i + j) % 2 == 0 { 1.0 } else { -1.0 };
        let c = choose(i + j - 2, i - 1);
        sign * ((i + j - 1) as f64) * choose(n + i - 1, n - j) * choose(n + j - 1, n - i) * c * c
    })
}

/// Thin and full SVD checks at m x n: residual, orthogonality, order,
/// and `svdvals` agreeing bit for bit with `svd().s()`.
fn shape_case(m: usize, n: usize) {
    let a = rand(m, n, (7 * m + n) as u64);
    let f = try! pkg::svd(a);
    let k = m.min(n);
    expect(f.u().shape() == [m, k] && f.vt().shape() == [k, n], f"thin shapes at {m} x {n}");
    let r = units(a, rebuild(f), m.max(n));
    expect(r < 8.0, f"||A - USV^T|| = {r} at {m} x {n}");
    expect(orth(f.u()) < 8.0 && orth(f.v()) < 8.0, f"orthogonality at {m} x {n}");
    let s = f.s();
    for i in 1..k { expect(s[i] <= s[i - 1], "falling"); }
    expect(try! pkg::svdvals(a) == s, f"svdvals = svd().s() at {m} x {n}");
}

#[test]
fn tall_and_wide() {
    // Jacobi (n <= 16), Golub-Kahan after a QR (m >= 1.6n), Golub-Kahan
    // on A itself, each tall and wide.
    // 260 x 300 also takes the workers' paths, with blocks of 64 that
    // do not divide n.
    for (m, n) in [(2000usize, 3usize), (500, 16), (300, 17), (1000, 40), (120, 100), (200, 199), (260, 300)] {
        shape_case(m, n);
        shape_case(n, m);
    }
    for (m, n) in [(300usize, 40usize), (40, 300), (60, 50)] {
        let a = rand(m, n, 5);
        let g = try! pkg::svd_full(a);
        expect(g.u().shape() == [m, m] && g.vt().shape() == [n, n], "full shapes");
        expect(orth(g.u()) < 8.0 && orth(g.v()) < 8.0, f"full orthogonality at {m} x {n}");
        let k = m.min(n);
        let us = g.u()[:, 0:k] .* g.s()[none, :];
        expect(units(a, try! pkg::matmul(us, g.vt()[0:k, :]), m.max(n)) < 8.0, "full residual");
    }
}

#[test]
fn large_rank_deficient() {
    // Rank 30 products, tall and wide: rank, pinv identities, null space.
    let a = try! pkg::matmul(rand(400, 30, 1), rand(30, 50, 2));
    expect(try! pkg::rank(a) == 30, "rank 30 of 400 x 50");
    expect(try! pkg::rank(a.t().copy()) == 30, "rank 30 of 50 x 400");
    let p = try! pkg::pinv(a);
    let apa = try! pkg::matmul(try! pkg::matmul(a, p), a);
    expect(units(a, apa, 400) < 20.0, "A A+ A = A");
    let w = a.t().copy();
    let z = try! pkg::null_space(w);
    expect(z.shape() == [400, 370] && orth(z) < 8.0, "null space of the wide one");
    expect(fro(try! pkg::matmul(w, z)) < 400.0 * EPS * fro(w), "A z = 0");
    let f = try! pkg::svd(w);
    expect(f.rank(none) == 30, "Svd::rank");
}

#[test]
fn known_singular_values() {
    // A = Q D with orthonormal Q and D = diag(2^-j): the singular values
    // are D to rounding (scaling by powers of 2 is exact).
    for (m, n, step) in [(40usize, 12usize, 4i32), (300, 30, 1)] {
        let q = (try! pkg::qr(rand(m, n, 9))).q();
        let a: Matrix<f64> = Array::from_fn([m, n], |ix: [usize; 2]| -> f64 { q[ix[0], ix[1]] * 2.0 ** (-step * (ix[1] as i32)) });
        let s = try! pkg::svdvals(a);
        for j in 0..n {
            let want = 2.0 ** (-step * (j as i32));
            if n <= 16 {
                // Jacobi: every value to a few n eps relative, here down
                // to 2^-44.
                close(s[j] / want, 1.0, 4.0 * (n as f64) * EPS, f"relative s[{j}]");
            } else {
                // Golub-Kahan: n eps ||A|| absolute.
                close(s[j], want, 4.0 * (n as f64) * EPS, f"absolute s[{j}]");
            }
        }
        let tol = if n <= 16 { 1e-12 } else { 1e-4 };
        close(try! pkg::cond(a) / 2.0 ** (step * (n as i32 - 1)), 1.0, tol, "cond");
    }
}

#[test]
fn bidiagonal_edges() {
    // n > 16, so the Golub-Kahan kernel: already diagonal, zero, a zero
    // and a repeated column, extreme scales, f32.
    let i40 = pkg::eye::<f64>(40);
    let f = try! pkg::svd(i40);
    expect(f.s() == Array::full([40], 1.0) && orth(f.u()) < 1.0 && orth(f.v()) < 1.0, "identity");
    let z: Matrix<f64> = Array::zeros([40, 20]);
    let g = try! pkg::svd(z);
    expect(g.s() == Array::zeros([20]) && orth(g.u()) < 1.0 && orth(g.v()) < 1.0, "zero");
    let a = rand(40, 25, 13);
    for i in 0..40 {
        a[i, 3] = 0.0;
        a[i, 7] = a[i, 2];
    }
    let h = try! pkg::svd(a);
    expect(units(a, rebuild(h), 40) < 8.0 && orth(h.u()) < 8.0 && orth(h.v()) < 8.0, "deficient columns");
    expect(h.rank(none) == 23, "rank 23");
    let b = rand(50, 30, 17);
    let sb = try! pkg::svdvals(b);
    for scale in [1e300, 1e-300] {
        let s = try! pkg::svdvals(b .* scale);
        for j in 0..30 { close(s[j] / scale, sb[j], 1e-13, f"scaled by {scale}"); }
    }
    let c = rand(60, 40, 19).map(|x: f64| -> f32 { x as f32 });
    let fc = try! pkg::svd(c);
    let back = try! pkg::matmul(fc.u() .* fc.s()[none, :], fc.vt());
    let m = 0.0f32;
    for x in back .- c { m = m.max(x.abs()); }
    expect((m as f64) < 60.0 * 60.0 * EPS32, f"f32 residual {m}");
}
