use pkg::AsVector;
use core::array::{Matrix, Vector};
use core::num::Complex;

fn total<X: AsVector<f64>>(x: X) -> f64 {
    let v: Vector<f64> = x.as_vector();
    v.sum()
}

fn cx<X: AsVector<Complex<f64>>>(x: X) -> Vector<Complex<f64>> {
    let v: Vector<Complex<f64>> = x.as_vector();
    v
}

#[test]
fn every_form() {
    let v: Vector<f64> = [1, 2, 3];
    assert(total(v) == 6.0);
    assert(total([1, 2, 3]) == 6.0);
    assert(total([0.5, 1.5]) == 2.0);
    assert(total([1.5f32, 2.5f32]) == 4.0);
    assert(total([1i32, 2i32]) == 3.0);
    assert(total([1usize, 2usize]) == 3.0);
    assert(total(1..4) == 6.0);
    assert(total(4..1) == 0.0);
    let xs: List<f64> = [];
    assert(total(xs) == 0.0);
    let f: Vector<f32> = [1, 2];
    assert(total(f) == 3.0);
    let a: [f64; 2] = [1.0, 2.0];
    assert(total(a) == 3.0);
    let k: [i64; 2] = [1, 2];
    assert(total(k) == 3.0);
    let z = cx([1.0, 2.0]);
    assert(z[1] == Complex::new(2.0, 0.0));
    let w: Vector<Complex<f64>> = [1.0 + 2.0i];
    assert(cx(w)[0].im == 2.0);
    assert(cx(v)[2].re == 3.0);
}

#[test]
fn shares_lists_and_vectors() {
    let xs: List<f64> = [1.0, 2.0];
    let v: Vector<f64> = xs.as_vector();
    xs[0] = 5.0;
    assert(v[0] == 5.0);
    let u: Vector<f64> = v.as_vector();
    assert(u[0] == 5.0);
}

#[test]
fn solve_takes_a_list() {
    let a: Matrix<f64> = [[2, 0], [0, 4]];
    let b: List<f64> = [2.0, 4.0];
    let x = try! pkg::solve(a, b);
    assert(x == [1.0, 1.0]);
    let l = try! pkg::lstsq(a, b);
    let v: Vector<f64> = l.as_vector();
    assert(v.all_close(x.as_vector()));
}
