// Vector and matrix norms. The 2-norm of a vector scales by its largest
// entry first, so squares neither overflow nor underflow.

use pkg::dense::Mat;
use pkg::factor::qr::nrm2;
use pkg::scalar::zero;
use pkg::{LinalgError, Scalar};
use core::array::{Matrix, Vector};

/// Which norm: `One` (sum of |x|; for a matrix the largest column sum),
/// `Two` (Euclidean; for a matrix the largest singular value), `Inf`
/// (largest |x|; for a matrix the largest row sum), `Fro` (Frobenius:
/// the 2-norm of all entries).
///
/// ```nabi
/// use core::array::Matrix;
/// use linalg::Norm;
///
/// let a: Matrix<f64> = [[3, 0], [0, 4]];
/// assert(try linalg::matrix_norm(a, Norm::Two) == 4.0);
/// assert(try linalg::matrix_norm(a, Norm::Fro) == 5.0);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub enum Norm {
    One,
    Two,
    Inf,
    Fro,
}

/// The Euclidean norm of `v`.
///
/// ```nabi
/// use core::array::Vector;
///
/// let v: Vector<f64> = [3, 4];
/// assert(linalg::norm(v) == 5.0);
/// let big: Vector<f64> = [3e200, 4e200];   // the squares would overflow
/// assert((linalg::norm(big) / 5e200 - 1.0).abs() < 1e-15);
/// let n = v .* 2.0 |> linalg::norm;           // `|>` binds loosest
/// assert(n == 10.0);
/// ```
pub fn norm<T: Scalar>(v: Vector<T>) -> T::Real {
    let m: Mat<T> = Mat::col(v);
    nrm2(m.d, 0, 1, m.r)
}

/// The `ord` norm of a vector (`Fro` is `Two`).
///
/// ```nabi
/// use core::array::Vector;
/// use linalg::Norm;
///
/// let v: Vector<f64> = [1, -3, 2];
/// assert(linalg::vector_norm(v, Norm::One) == 6.0);
/// assert(linalg::vector_norm(v, Norm::Inf) == 3.0);
/// ```
pub fn vector_norm<T: Scalar>(v: Vector<T>, ord: Norm) -> T::Real {
    match ord {
        Norm::One => {
            let s = zero::<T::Real>();
            for x in v { s = s + x.modulus(); }
            s
        },
        Norm::Inf => {
            let s = zero::<T::Real>();
            for x in v { s = s.max(x.modulus()); }
            s
        },
        _ => norm(v),
    }
}

/// The `ord` norm of a matrix. `Two` takes an SVD (O(mn^2)) and can
/// throw `NoConvergence`; the others are O(mn) and never throw for
/// finite input.
///
/// ```nabi
/// use core::array::Matrix;
/// use linalg::Norm;
///
/// let a: Matrix<f64> = [[1, -2], [3, 4]];
/// assert(try linalg::matrix_norm(a, Norm::One) == 6.0);
/// assert(try linalg::matrix_norm(a, Norm::Inf) == 7.0);
/// assert((try linalg::matrix_norm(a, Norm::Fro) - 30.0.sqrt()).abs() < 1e-12);
/// ```
pub fn matrix_norm<T: Scalar>(a: Matrix<T>, ord: Norm) throws (LinalgError) -> T::Real {
    match ord {
        Norm::One => norm1(Mat::of(a)),
        Norm::Inf => norm1(Mat::of(a).t(false)),
        Norm::Fro => {
            let m: Mat<T> = Mat::of(a);
            nrm2(m.d, 0, 1, m.r * m.c)
        },
        Norm::Two => {
            let s = try pkg::svdvals(a);
            if s.len() == 0 { zero::<T::Real>() } else { s[0] }
        },
    }
}

/// The largest column sum of |a_ij|.
pub(pkg) fn norm1<T: Scalar>(a: Mat<T>) -> T::Real {
    let best = zero::<T::Real>();
    for j in 0..a.c {
        let s = zero::<T::Real>();
        for i in 0..a.r { s = s + a.at(i, j).modulus(); }
        best = best.max(s);
    }
    best
}
